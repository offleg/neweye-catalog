  "helpers": [
    {
      "id": "agent-desktop",
      "name": "agent-desktop",
      "does": "Lets an AI tool look at the screen and click, type and read inside desktop apps.",
      "forTasks": [
        "Test a desktop app",
        "Fill forms in an app",
        "Read what an app shows"
      ],
      "url": "https://agent-browser.dev/desktop",
      "gives": [
        "see_screen",
        "operate_apps"
      ],
      "forTools": "all",
      "installsInto": "computer",
      "install": [
        {
          "label": "Mac (Homebrew)",
          "command": "brew install agent-desktop"
        },
        {
          "label": "Any system (npm)",
          "command": "npm install -g agent-desktop"
        },
        {
          "label": "Windows",
          "command": "npm install -g agent-desktop",
          "note": "Needs Node.js. The first run asks for permission to control apps."
        }
      ],
      "detect": {
        "bin": "agent-desktop"
      }
    },
    {
      "id": "graphify",
      "name": "Graphify",
      "does": "Builds a map of a project's code so the AI reads the map instead of every file. Fewer tokens per question on big projects.",
      "forTasks": [
        "Ask questions about a big codebase",
        "Find what depends on what",
        "Save tokens"
      ],
      "url": "https://pypi.org/project/graphifyy/",
      "gives": [],
      "forTools": "all",
      "installsInto": "project",
      "install": [
        {
          "label": "Install the program",
          "command": "uv tool install graphifyy",
          "note": "Or: pip install graphifyy (the name has two y's)."
        },
        {
          "label": "Teach Claude Code to use it",
          "command": "graphify install --platform claude"
        },
        {
          "label": "Teach Codex to use it",
          "command": "graphify install --platform codex"
        },
        {
          "label": "Teach OpenCode to use it",
          "command": "graphify install --platform opencode"
        },
        {
          "label": "Make the map for this project",
          "command": "graphify update .",
          "note": "Runs in the project folder and reads only the code files, so it costs no tokens. To include documents and pictures too, type /graphify . inside your AI tool in that folder instead; that uses the tool's tokens once."
        }
      ],
      "detect": {
        "bin": "graphify",
        "projectDir": "graphify-out"
      }
    },
    {
      "id": "mempalace",
      "name": "MemPalace",
      "does": "One memory every tool can read. What you did in Claude Code, Codex or OpenCode can be found from any of them.",
      "forTasks": [
        "Pick up work in another tool",
        "Remember decisions across sessions"
      ],
      "url": "https://mempalace.dev",
      "gives": [
        "remember"
      ],
      "forTools": [
        "Claude Code",
        "Codex",
        "OpenCode"
      ],
      "installsInto": "computer",
      "install": [
        {
          "label": "Install the program",
          "command": "pip install mempalace",
          "note": "See mempalace.dev for other ways."
        },
        {
          "label": "Connect Claude Code",
          "command": "claude mcp add --scope user mempalace -- mempalace-mcp"
        },
        {
          "label": "Connect Codex",
          "command": "codex mcp add mempalace -- mempalace-mcp"
        },
        {
          "label": "Connect OpenCode",
          "note": "Press Connect next to OpenCode on the Memory screen. It shows the lines to add to OpenCode's settings file."
        }
      ],
      "detect": {
        "special": "mempalace"
      }
    },
    {
      "id": "unslop",
      "name": "UnSlop",
      "does": "Guard rails for AI-written code: checks each change for the usual AI mistakes before it lands.",
      "forTasks": [
        "Keep AI-written code clean",
        "Catch sloppy changes early"
      ],
      "url": "https://github.com/offleg/UnSlop",
      "gives": [],
      "forTools": "all",
      "installsInto": "project",
      "install": [
